# Gamebian Debian (trixie) profile — sourced by gamebian-iso/setup.sh and build.sh

GAMEBIAN_PROFILE_ID=debian
GAMEBIAN_DISTRO=debian
GAMEBIAN_SUITE=trixie
GAMEBIAN_PRODUCT_NAME=Gamebian
GAMEBIAN_PRODUCT_VERSION=
GAMEBIAN_LIVE_HOSTNAME=gamebian-openbox

GAMEBIAN_BUILD_ROOT_VAR=GAMEBIANOS_BUILD_ROOT
GAMEBIAN_BUILD_ROOT_DEFAULT=/home/khinds/gamebianos-build-iso

LB_MODE=
LB_DISTRIBUTION=trixie
LB_PARENT_DISTRIBUTION=
LB_ARCHIVE_AREAS="main contrib non-free non-free-firmware"
LB_MIRROR=
LB_LINUX_FLAVOURS=
LB_INITRAMFS=
LB_LIVE_USER_PASSWORD=
LB_FORCE_LIVE_LIST=0
LB_UBUNTU_KEYRING_CHECK=0

GAMEBIAN_ENSURE_APT_SCRIPT=ensure-apt-contrib-nonfree.sh
GAMEBIAN_RETROARCH_LIST=debian-retroarch.list

GAMEBIAN_GAMESCOPE_STRATEGY=source_build
GAMEBIAN_GAMESCOPE_GIT_REF=3.16.22
GAMEBIAN_GRUB_CERATOPSIAN=1
GAMEBIAN_SID_UNMIX=1
GAMEBIAN_LIVE_DNS_FIX=0
GAMEBIAN_NM_ETHERNET_OVERRIDE=0

GAMEBIAN_CALAMARES_INSTALLER=calamares-install-debian
GAMEBIAN_WELCOME_URLS=debian.org,deb.debian.org

GAMEBIAN_DISTRO_CONF=debian.distro.conf
GAMEBIAN_GRUB_FALLBACK_MSG="Debian testing GRUB art"
