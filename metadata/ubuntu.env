# GamebianUbuntu (resolute) profile — sourced by gamebian-iso-ubuntu/setup.sh and build.sh

GAMEBIAN_PROFILE_ID=ubuntu
GAMEBIAN_DISTRO=ubuntu
GAMEBIAN_SUITE=resolute
GAMEBIAN_PRODUCT_NAME=GamebianUbuntu
GAMEBIAN_PRODUCT_VERSION="26.04 LTS"
GAMEBIAN_LIVE_HOSTNAME=gamebian-ubuntu

GAMEBIAN_BUILD_ROOT_VAR=GAMEBIANUBUNTU_BUILD_ROOT
GAMEBIAN_BUILD_ROOT_DEFAULT=/home/khinds/gamebian-ubuntu-build-iso

LB_MODE=ubuntu
LB_DISTRIBUTION=resolute
LB_PARENT_DISTRIBUTION=resolute
LB_ARCHIVE_AREAS="main restricted universe multiverse"
LB_MIRROR=http://archive.ubuntu.com/ubuntu/
LB_LINUX_FLAVOURS=generic
LB_INITRAMFS=live-boot
LB_LIVE_USER_PASSWORD=live
LB_FORCE_LIVE_LIST=1
LB_UBUNTU_KEYRING_CHECK=1

GAMEBIAN_ENSURE_APT_SCRIPT=ensure-apt-gaming-repos.sh
GAMEBIAN_RETROARCH_LIST=ubuntu-retroarch.list

GAMEBIAN_GAMESCOPE_STRATEGY=apt_preferred
GAMEBIAN_GAMESCOPE_GIT_REF=
GAMEBIAN_GRUB_CERATOPSIAN=0
GAMEBIAN_SID_UNMIX=0
GAMEBIAN_LIVE_DNS_FIX=1
GAMEBIAN_NM_ETHERNET_OVERRIDE=1

GAMEBIAN_CALAMARES_INSTALLER=calamares-install-gamebian
GAMEBIAN_WELCOME_URLS=ubuntu.com,archive.ubuntu.com

GAMEBIAN_DISTRO_CONF=ubuntu.distro.conf
GAMEBIAN_GRUB_FALLBACK_MSG="default Ubuntu GRUB art"
