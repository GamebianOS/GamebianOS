# Live installer image. Openbox is only a window for Calamares and is removed
# from the installed disk (packages.conf). No panel, file manager, or terminal.
# Steam is installed by Calamares (packages.conf + gamebian-install-steam).

sudo
systemd-sysv
initramfs-tools
# live-config Recommends — required with --apt-recommends false.
# Without user-setup the live user is never created → tty/LightDM "Authentication failure".
user-setup
live-tools
locales
keyboard-configuration
network-manager
# Standalone Wi-Fi dialog for the live installer (removed from the installed disk).
nm-connection-editor
mate-polkit
gnome-keyring
libpam-gnome-keyring
iproute2
curl
ca-certificates
openssh-client
openssh-server
rsync
vim
x11-utils
hicolor-icon-theme

lightdm
lightdm-gtk-greeter
# LightDM only Recommends xserver-xorg — required explicitly with --apt-recommends false.
xserver-xorg
openbox

python3
x11-xserver-utils

# gamescope from Ubuntu universe — needed on the installed system.
gamescope
xwayland
# RADV/ANV (not a Recommends of xserver-xorg). gamescope needs this or it only sees llvmpipe.
mesa-vulkan-drivers

calamares
# Calamares unpackfs needs unsquashfs — only a Recommends of calamares.
squashfs-tools
# Calamares partition/format — not pulled with --apt-recommends false.
e2fsprogs
dosfstools
parted
qml-module-qtquick-controls2
