# Minimal Ubuntu live ISO desktop (<2GB target).
# Deferred to Calamares (live is try/install only):
#   steam-installer, steam-devices, papirus (large), epiphany, RetroArch/emulators,
#   flatpak, gamebian-web Python stack
# See packages.conf + gamebian-web-install + gamebian-install-steam.

sudo
systemd-sysv
initramfs-tools
# live-config Recommends — required with --apt-recommends false.
# Without user-setup the live user is never created → tty/LightDM "Authentication failure".
user-setup
live-tools
locales
keyboard-configuration
network-manager
nm-tray
bluez
blueman
qt5-gtk-platformtheme
qt6-gtk-platformtheme
qt6ct
hicolor-icon-theme
libqt5svg5
nm-connection-editor
mate-polkit
gnome-keyring
libpam-gnome-keyring
iproute2
curl
ca-certificates
openssh-client
openssh-server
rsync
vim
x11-utils
zenity
libnotify-bin
xfce4-notifyd

# Papirus deferred to Calamares (hundreds of MB); live uses hicolor fallbacks.
lightdm
lightdm-gtk-greeter
# LightDM only Recommends xserver-xorg — required explicitly with --apt-recommends false.
# Without it the live ISO boots to getty (TTY) and Calamares never starts.
xserver-xorg

openbox
python3
python3-gi
python3-evdev
python3-tk
gir1.2-nm-1.0
lxappearance
lxappearance-obconf
lxrandr
x11-xserver-utils
lxpanel
rofi
feh
thunar
xfce4-terminal
pavucontrol

# gamescope from Ubuntu universe — needed after unpack onto disk; small vs Steam/emulators.
gamescope
xwayland

calamares
# Calamares unpackfs needs unsquashfs — only a Recommends of calamares.
squashfs-tools
# Calamares partition/format — not pulled with --apt-recommends false.
# Without e2fsprogs, erase-disk install fails creating the ext4 filesystem.
e2fsprogs
dosfstools
parted
qml-module-qtquick-controls2
