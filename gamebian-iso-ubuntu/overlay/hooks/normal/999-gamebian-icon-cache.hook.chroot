#!/bin/sh
set -e
for _theme in Papirus Papirus-Dark; do
	_dir="/usr/share/icons/${_theme}"
	if [ -d "${_dir}" ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
		gtk-update-icon-cache -f "${_dir}" 2>/dev/null || true
	fi
done
chmod 0644 /usr/share/gamebian/gamebian-openbox-session-env.sh 2>/dev/null || true
chmod 0755 /usr/local/sbin/gamebian-install-tray-icons 2>/dev/null || true
chmod 0755 /usr/local/bin/gamebian-nm-tray 2>/dev/null || true
chmod 0755 /usr/share/gamebian/gamebian-nm-status-icon.py 2>/dev/null || true
/usr/local/sbin/gamebian-install-tray-icons 2>/dev/null || true

# Session / Steam glue (merged from former 995-gamebian-steam-bigpicture-bin).
chmod 0755 /usr/local/bin/gamebian-steam-bigpicture 2>/dev/null || true
chmod 0755 /usr/bin/steamos-session-select 2>/dev/null || true
chmod 0755 /usr/sbin/gamebian-steam-switch-to-desktop 2>/dev/null || true
chmod 0755 /usr/sbin/gamebian-enable-openbox-lightdm-session 2>/dev/null || true
chmod 0755 /usr/sbin/gamebian-enter-steam-kiosk-session 2>/dev/null || true
chmod 0755 /usr/local/bin/gamebian-steam-gamescope-session 2>/dev/null || true
chmod 0755 /usr/local/bin/gamebian-autologin-session 2>/dev/null || true
chmod 0755 /usr/local/bin/gamebian-fix-steam-boot 2>/dev/null || true
chmod 0755 /usr/local/sbin/gamebian-install-gamescope /usr/local/sbin/gamebian-install-steam 2>/dev/null || true
chmod 0644 /usr/share/gamebian/xsessions/gamebian-autologin.desktop 2>/dev/null || true
chmod 0644 /usr/share/gamebian/gamebian-steam-gamescope-env.sh 2>/dev/null || true
chmod 0755 /usr/sbin/gamebian-enable-steam-lightdm-session 2>/dev/null || true
chmod 0755 /usr/local/bin/gamebian-debug-boot-session 2>/dev/null || true
chmod 0755 /usr/local/bin/gamebian-debug-calamares-welcome 2>/dev/null || true
chmod 0755 /usr/local/sbin/gamebian-sshd-live-prep /usr/local/sbin/gamebian-enable-sshd-installed 2>/dev/null || true
chmod 0755 /usr/local/sbin/gamebian-live-dns-fix 2>/dev/null || true
chmod 0755 /usr/local/sbin/gamebian-live-calamares-prep 2>/dev/null || true
chmod 0644 /usr/share/gamebian/gamebian-session-log.sh 2>/dev/null || true
chmod 0755 /usr/share/gamebian/gamebian-openbox-notify.sh 2>/dev/null || true
chmod 0644 /usr/share/gamebian/gamebian-steam-ready.sh 2>/dev/null || true
chmod 0644 /usr/share/gamebian/xsessions/*.desktop 2>/dev/null || true
chmod 0440 /etc/sudoers.d/gamebian-enable-steam-session 2>/dev/null || true

exit 0
