#!/bin/sh
# Start the fullscreen gamescope + Steam session if it is not already running.

PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games${PATH:+:$PATH}"
export PATH

LOG="${XDG_CACHE_HOME:-${HOME}/.cache}/gamebian/enter-steam-kiosk.log"
DISPLAY="${DISPLAY:-:0}"
export DISPLAY
export XAUTHORITY="${XAUTHORITY:-${HOME}/.Xauthority}"

log() {
	_ts="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date)"
	_msg="[enter-steam-kiosk] $_ts $*"
	echo "$_msg" >&2
	mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
	echo "$_msg" >>"$LOG" 2>/dev/null || true
}

rm -f "${HOME}/.config/gamebian/switch-to-openbox" \
	"${HOME}/.config/gamebian/prefer-openbox-desktop" 2>/dev/null || true

if [ -r /usr/share/gamebian/gamebian-steam-kiosk-env.sh ]; then
	# shellcheck disable=SC1091
	. /usr/share/gamebian/gamebian-steam-kiosk-env.sh
fi

log "start DISPLAY=$DISPLAY user=$(id -un)"

if pgrep -u "$(id -un)" -x gamescope >/dev/null 2>&1; then
	log "already in gamescope kiosk"
	exit 0
fi

if gamebian_gamescope_session_supervisor_running 2>/dev/null; then
	log "supervisor active — request gamescope kiosk"
	gamebian_request_gamescope_kiosk 2>/dev/null || true
	exit 0
fi

if [ -r /usr/share/gamebian/gamebian-steam-gamescope-env.sh ]; then
	# shellcheck disable=SC1091
	. /usr/share/gamebian/gamebian-steam-gamescope-env.sh
	gamebian_source_steam_gamescope_env
fi

export GAMEBIAN_GAMESCOPE_SESSION=1
export DESKTOP_SESSION=gamebian-steam
export XDG_SESSION_DESKTOP=gamebian-steam
export XDG_CURRENT_DESKTOP=gamebian-steam
gamebian_kiosk_marker_set 2>/dev/null || true

log "launching gamebian-steam-bigpicture on $DISPLAY"
exec /usr/local/bin/gamebian-steam-bigpicture
