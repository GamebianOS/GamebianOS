#!/bin/sh
# Session actions for Openbox desktop menu and rofi launcher.
# Usage: gamebian-session-action logout|restart|reboot

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games${PATH:+:$PATH}"
export DISPLAY="${DISPLAY:-:0}"

_confirm() {
	_text="$1"
	_title="${2:-Gamebian}"
	if command -v zenity >/dev/null 2>&1; then
		zenity --question --no-wrap --title="${_title}" --text="${_text}" 2>/dev/null
		return $?
	fi
	printf '%s [y/N] ' "${_text}"
	read -r _ans || _ans=""
	case "${_ans}" in
		y|Y|yes|YES) return 0 ;;
		*) return 1 ;;
	esac
}

case "${1:-}" in
	logout)
		if [ -n "${XDG_SESSION_ID:-}" ] && command -v loginctl >/dev/null 2>&1; then
			loginctl terminate-session "${XDG_SESSION_ID}" 2>/dev/null && exit 0
		fi
		exec openbox --exit
		;;
	restart)
		openbox --restart 2>/dev/null || true
		if pgrep -x lxpanel >/dev/null 2>&1; then
			pkill -x lxpanel 2>/dev/null || true
			sleep 0.2
		fi
		if command -v lxpanel >/dev/null 2>&1; then
			lxpanel &
		fi
		if [ -x /usr/share/gamebian/gamebian-lxpanel-tray.sh ]; then
			/usr/share/gamebian/gamebian-lxpanel-tray.sh &
		fi
		exit 0
		;;
	reboot)
		_confirm "Reboot the computer now?" "Reboot" || exit 0
		if command -v loginctl >/dev/null 2>&1 && loginctl reboot 2>/dev/null; then
			exit 0
		fi
		if command -v systemctl >/dev/null 2>&1; then
			exec systemctl reboot
		fi
		exec reboot
		;;
	shutdown|poweroff)
		_confirm "Shut down the computer now?" "Shut Down" || exit 0
		if command -v loginctl >/dev/null 2>&1 && loginctl poweroff 2>/dev/null; then
			exit 0
		fi
		if command -v systemctl >/dev/null 2>&1; then
			exec systemctl poweroff
		fi
		exec shutdown -h now
		;;
	*)
		echo "Usage: gamebian-session-action logout|restart|reboot|shutdown" >&2
		exit 1
		;;
esac
