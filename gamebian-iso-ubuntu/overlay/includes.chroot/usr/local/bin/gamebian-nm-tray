#!/bin/sh
# Network tray for lxpanel: GNOME nm-applet (GTK XEmbed) — same approach as SamStation.
# Qt nm-tray frequently shows no icon / white squares in lxpanel's legacy tray.

PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games${PATH:+:$PATH}"
export PATH

if [ -r /usr/share/gamebian/gamebian-openbox-session-env.sh ]; then
	# shellcheck disable=SC1091
	. /usr/share/gamebian/gamebian-openbox-session-env.sh
	gamebian_openbox_session_env
fi

# nm-applet expects a GNOME-ish desktop id for icon lookup.
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-GNOME}"

if command -v nm-applet >/dev/null 2>&1; then
	exec nm-applet "$@"
fi

# Fallbacks if network-manager-applet is missing on an older image.
if [ -x /usr/share/gamebian/gamebian-nm-status-icon.py ]; then
	exec python3 /usr/share/gamebian/gamebian-nm-status-icon.py "$@"
fi

if command -v nm-tray >/dev/null 2>&1; then
	export XDG_CURRENT_DESKTOP=LXDE
	exec nm-tray "$@"
fi

exec nm-connection-editor "$@"
