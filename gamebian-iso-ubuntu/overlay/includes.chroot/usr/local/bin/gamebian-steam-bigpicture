#!/bin/sh
# Launch Steam Big Picture inside gamescope on the current X display (LightDM session or nested under Openbox).
# -e: embed under host X11; -f: fullscreen that window (deck-like; not a small decor window).
# Quitting Steam exits gamescope; under Openbox you return to the desktop. Under LightDM’s
# gamebian-steam-gamescope session, Power → Switch to Desktop runs steamos-session-select → Openbox
# (same LightDM login; autologin reset to openbox). Opt out of -steamos3: GAMEBIAN_STEAM_NO_STEAMOS3=1.
# Set GAMEBIAN_GAMESCOPE_WINDOWED=1 to drop -f (debug / windowed).
# Set GAMEBIAN_SKIP_GAMESCOPE=1 to skip gamescope (VMs without Vulkan DRM / llvmpipe).
# -e (--steam) enables gamescope Steam integration (steamcompmgr input routing). Required for
# controller input in games; omitting it breaks gamepads in the kiosk session. Opt out:
# GAMEBIAN_GAMESCOPE_NO_STEAM=1. Legacy kiosk-only opt-out: GAMEBIAN_GAMESCOPE_KIOSK_EMBED=0.
# Toggle fullscreen if stuck: Meta/Super+F (gamescope default).
# Optional kiosk output size when not embedding: GAMEBIAN_GAMESCOPE_WH="-W 1920 -H 1080".
# Embedded kiosk (-e, default): uses native X resolution (-f fullscreen); no forced -W/-H.
# Bare compositor (GAMEBIAN_GAMESCOPE_KIOSK_EMBED=0): auto -W/-H from xrandr preferred mode.
# Hybrid NVIDIA + Mesa NVK: gamescope often fails unless you force another Vulkan ICD or device:
#   GAMEBIAN_VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/radeon_icd.json  (colon-separated list ok; name varies — ls icd.d)
#   GAMEBIAN_GAMESCOPE_EXTRA_ARGS='--prefer-vk-device …'  # run: gamescope --help
# Optional: GAMEBIAN_GAMESCOPE_DISABLE_WSI=1 → ENABLE_GAMESCOPE_WSI=0 (workaround some NV hybrid hangs).
# Kiosk hides the mouse cursor when a USB mouse is plugged in (controller-only play): gamescope -C 0 by default.
# Override delay (ms): GAMEBIAN_GAMESCOPE_HIDE_CURSOR_DELAY=3000; disable: -1 or GAMEBIAN_GAMESCOPE_NO_HIDE_CURSOR=1.
# Persist for LightDM kiosk: ~/.config/gamebian/steam-gamescope.env (sourced by gamebian-steam-gamescope-session).

LOG="${XDG_CACHE_HOME:-${HOME}/.cache}/gamebian/steam-bigpicture.log"

log() {
	_ts="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date)"
	_msg="[gamebian-steam-bigpicture] $_ts $*"
	echo "$_msg" >&2
	mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
	echo "$_msg" >>"$LOG" 2>/dev/null || true
}

find_bin() {
	_name="$1"
	shift
	for _c in "$@"; do
		if [ -n "$_c" ] && [ -x "$_c" ]; then
			echo "$_c"
			return 0
		fi
	done
	if command -v "$_name" >/dev/null 2>&1; then
		command -v "$_name"
		return 0
	fi
	return 1
}

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games${PATH:+:$PATH}"

if [ -r /usr/share/gamebian/gamebian-display-resolution.sh ]; then
	# shellcheck disable=SC1091
	. /usr/share/gamebian/gamebian-display-resolution.sh
fi

if [ -r /usr/share/gamebian/gamebian-steam-kiosk-env.sh ]; then
	# shellcheck disable=SC1091
	. /usr/share/gamebian/gamebian-steam-kiosk-env.sh
fi
if [ -r /usr/share/gamebian/gamebian-steam-ready.sh ]; then
	# shellcheck disable=SC1091
	. /usr/share/gamebian/gamebian-steam-ready.sh
fi
if [ -r /usr/share/gamebian/gamebian-steam-gamescope-env.sh ]; then
	# shellcheck disable=SC1091
	. /usr/share/gamebian/gamebian-steam-gamescope-env.sh
	gamebian_source_steam_gamescope_env
fi

GAMESCOPE_BIN="$(find_bin gamescope /usr/games/gamescope /usr/bin/gamescope /usr/local/bin/gamescope)" || GAMESCOPE_BIN=""
STEAM_BIN="$(find_bin steam /usr/games/steam /usr/bin/steam /usr/local/bin/steam)" || STEAM_BIN=""

if [ -z "$STEAM_BIN" ]; then
	log "steam not on PATH — need first-boot setup"
	if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ]; then
		exec /usr/bin/openbox-session
	fi
	exit 1
fi

# Kiosk autologin requires a Steam account sign-in (loginusers.vdf).
if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ] \
	&& ! gamebian_steam_kiosk_ready 2>/dev/null; then
	log "Steam not signed in; switching to Openbox setup"
	exec /usr/bin/openbox-session
fi

_use_gamescope=1
case "${GAMEBIAN_SKIP_GAMESCOPE:-}" in
	1|yes|true|YES|TRUE) _use_gamescope=0 ;;
esac
if command -v gamebian_use_steam_without_gamescope >/dev/null 2>&1 \
	&& gamebian_use_steam_without_gamescope; then
	_use_gamescope=0
elif [ -n "$GAMESCOPE_BIN" ] && ! "$GAMESCOPE_BIN" --help >/dev/null 2>&1; then
	log "gamescope broken (missing libs?) — Steam without compositor"
	GAMESCOPE_BIN=""
	_use_gamescope=0
elif [ -z "$GAMESCOPE_BIN" ]; then
	log "gamescope not installed — will start Steam without compositor"
	_use_gamescope=0
fi

if [ -n "${GAMEBIAN_VK_ICD_FILENAMES:-}" ]; then
	_icd_first="${GAMEBIAN_VK_ICD_FILENAMES%%:*}"
	if [ ! -r "$_icd_first" ]; then
		log "VK ICD file missing or unreadable: $_icd_first — ls /usr/share/vulkan/icd.d (often radeon_icd.json, not radeon_icd.x86_64.json)"
	else
		log "using VK ICD: ${GAMEBIAN_VK_ICD_FILENAMES}"
	fi
fi

# Nested under Openbox: skip if Steam is already running (menu / Super+Shift+S relaunch).
if [ -z "${GAMEBIAN_GAMESCOPE_SESSION:-}" ]; then
	if pgrep -u "$(id -un)" -x steam >/dev/null 2>&1 \
		|| pgrep -u "$(id -un)" -x steam.sh >/dev/null 2>&1; then
		case "${GAMEBIAN_STEAM_SIGNIN:-}" in
			1|yes|true|YES|TRUE)
				log "sign-in: Steam already running — opening main window"
				"$STEAM_BIN" >>"${LOG}" 2>&1 &
				exit 0
				;;
		esac
		exit 0
	fi
elif pgrep -u "$(id -un)" -x steam >/dev/null 2>&1; then
	pkill -u "$(id -un)" -x steam 2>/dev/null || true
	sleep 1
fi

FULLSCREEN="-f"
case "${GAMEBIAN_GAMESCOPE_WINDOWED:-}" in
	1|yes|true|YES|TRUE) FULLSCREEN="" ;;
esac

# Steam integration (-e) for controller input in games and stable Guide/chord handling.
_EMBED_UNDER_X=""
case "${GAMEBIAN_GAMESCOPE_NO_STEAM:-}" in
	1|yes|true|YES|TRUE) ;;
	*) _EMBED_UNDER_X="-e" ;;
esac
if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ]; then
	case "${GAMEBIAN_GAMESCOPE_KIOSK_EMBED:-}" in
		0|no|false|NO|FALSE) _EMBED_UNDER_X="" ;;
	esac
fi

# Kiosk output size (-W/-H): embedded (-e) uses native X resolution; bare compositor auto-detects.
_GAMESCOPE_WH=""
_GAMESCOPE_GAME_WH=""
if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ] \
	&& command -v gamebian_ensure_native_resolution >/dev/null 2>&1; then
	gamebian_ensure_native_resolution 2>/dev/null || true
fi
if [ -n "${GAMEBIAN_GAMESCOPE_WH:-}" ]; then
	_GAMESCOPE_WH="${GAMEBIAN_GAMESCOPE_WH}"
elif [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ] && [ -z "${_EMBED_UNDER_X}" ]; then
	case "${GAMEBIAN_GAMESCOPE_NO_AUTO_WH:-}" in
		1|yes|true|YES|TRUE) ;;
		*)
			if _auto_wh="$(gamebian_detect_gamescope_wh 2>/dev/null)"; then
				_GAMESCOPE_WH="${_auto_wh}"
				log "kiosk: compositor output from xrandr: ${_GAMESCOPE_WH}"
			else
				log "kiosk: xrandr auto size failed — set GAMEBIAN_GAMESCOPE_WH or fix DISPLAY"
			fi
			;;
	esac
elif [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ] && [ -n "${_EMBED_UNDER_X}" ]; then
	log "kiosk: embedded gamescope — native X resolution (no -W/-H override)"
fi
if [ -n "${GAMEBIAN_GAMESCOPE_GAME_WH:-}" ]; then
	_GAMESCOPE_GAME_WH="${GAMEBIAN_GAMESCOPE_GAME_WH}"
fi
_GAMESCOPE_REFRESH=""
if [ -n "${GAMEBIAN_GAMESCOPE_REFRESH:-}" ]; then
	_GAMESCOPE_REFRESH="-r ${GAMEBIAN_GAMESCOPE_REFRESH}"
fi

# Hide X cursor in kiosk (USB mouse often shows the default "X" pointer). gamescope -C = ms idle before hide.
_GAMESCOPE_HIDE_CURSOR=""
case "${GAMEBIAN_GAMESCOPE_NO_HIDE_CURSOR:-}" in
	1|yes|true|YES|TRUE) ;;
	*)
		if [ -n "${GAMEBIAN_GAMESCOPE_HIDE_CURSOR_DELAY+x}" ]; then
			case "${GAMEBIAN_GAMESCOPE_HIDE_CURSOR_DELAY}" in
				-1|off|no|disable|DISABLE|OFF|NO) ;;
				*)
					_GAMESCOPE_HIDE_CURSOR="-C ${GAMEBIAN_GAMESCOPE_HIDE_CURSOR_DELAY}"
					;;
			esac
		elif [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ]; then
			_GAMESCOPE_HIDE_CURSOR="-C 0"
		fi
		;;
esac

# Steam UI mode: gamepad (default), classic Big Picture, or plain Steam.
_steam_mode="-gamepadui"
case "${STEAM_BIGPICTURE_UI:-gamepad}" in
	classic|bigpicture) _steam_mode="-bigpicture" ;;
	plain|desktop) _steam_mode="" ;;
esac

# Under gamescope, Steam uses the SteamOS power menu and expects steamos-session-select for
# "Switch to Desktop". -steamos3 wires that path (steam-for-linux #11241 / #11749). Applies to
# LightDM kiosk and nested gamescope from Openbox when running Big Picture modes.
# Opt out entirely: GAMEBIAN_STEAM_NO_STEAMOS3=1 in steam-gamescope.env or the environment.
_steam_extras=""
case "${GAMEBIAN_STEAM_NO_STEAMOS3:-}" in
	1|yes|true|YES|TRUE) ;;
	*)
		case "${STEAM_BIGPICTURE_UI:-gamepad}" in
			plain|desktop) ;;
			*)
				if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ] \
					|| { [ "$_use_gamescope" -eq 1 ] && [ -n "${_steam_modes}" ]; }; then
					_steam_extras="-steamos3"
				fi
				;;
		esac
		;;
esac

log "gamescope=${GAMESCOPE_BIN:-none} steam=$STEAM_BIN use_gamescope=$_use_gamescope session=${GAMEBIAN_GAMESCOPE_SESSION:-0} DISPLAY=${DISPLAY:-unset} embed=${_EMBED_UNDER_X:-none} fullscreen=${FULLSCREEN:-} wh=${_GAMESCOPE_WH:-unset} game_wh=${_GAMESCOPE_GAME_WH:-unset} refresh=${_GAMESCOPE_REFRESH:-unset} hide_cursor=${_GAMESCOPE_HIDE_CURSOR:-off} steamos3=${_steam_extras:-none} VK_ICD_FILENAMES=${GAMEBIAN_VK_ICD_FILENAMES:-default} extra_args=${GAMEBIAN_GAMESCOPE_EXTRA_ARGS:-none}"

# Debian Steam layout: ensure ~/.local/share/Steam points at debian-installation.
if [ -r /usr/share/gamebian/gamebian-fix-steam-share.sh ]; then
	# shellcheck source=/usr/share/gamebian/gamebian-fix-steam-share.sh
	. /usr/share/gamebian/gamebian-fix-steam-share.sh
	gamebian_fix_steam_share
fi

# Library uploads write YAML first; Steam only reads shortcuts.vdf on a cold start.
_pending_shortcuts="${HOME}/.cache/gamebian/pending-steam-shortcuts-sync"
_gamebian_sync=""
if command -v gamebian >/dev/null 2>&1; then
	_gamebian_sync="gamebian --shortcuts"
elif command -v python3 >/dev/null 2>&1; then
	_gamebian_sync="python3 -m gamebian_app --shortcuts"
fi
if [ -n "$_gamebian_sync" ] && ! pgrep -u "$(id -un)" -x steam >/dev/null 2>&1; then
	if [ -f "$_pending_shortcuts" ] || ls "${HOME}/.local/share/gamebian/shortcuts/"*.yaml >/dev/null 2>&1; then
		log "syncing gamebian shortcuts into Steam before launch"
		# shellcheck disable=SC2086
		$_gamebian_sync >>"${HOME}/.cache/gamebian/steam-shortcuts-sync.log" 2>&1 || true
		rm -f "$_pending_shortcuts" 2>/dev/null || true
	fi
fi

gamebian_stop_gamescope_pid() {
	_pid="$1"
	[ -n "$_pid" ] || return 0
	kill -TERM "$_pid" 2>/dev/null || true
	_w=0
	while kill -0 "$_pid" 2>/dev/null && [ "${_w}" -lt 40 ]; do
		sleep 0.25
		_w=$((_w + 1))
	done
	kill -KILL "$_pid" 2>/dev/null || true
	wait "$_pid" 2>/dev/null || true
}

_run_gamescope() {
	_steam_args="$1"
	_xwayland=""
	if [ -n "${_EMBED_UNDER_X}" ]; then
		case "${GAMEBIAN_GAMESCOPE_XWAYLAND_COUNT:-2}" in
			0|no|off|OFF) ;;
			*)
				_xwc="${GAMEBIAN_GAMESCOPE_XWAYLAND_COUNT:-2}"
				_xwayland="--xwayland-count ${_xwc}"
				;;
		esac
	fi
	if [ -n "${GAMEBIAN_VK_ICD_FILENAMES:-}" ]; then
		export VK_ICD_FILENAMES="${GAMEBIAN_VK_ICD_FILENAMES}"
	fi
	case "${GAMEBIAN_GAMESCOPE_DISABLE_WSI:-}" in
		1|yes|true|YES|TRUE) export ENABLE_GAMESCOPE_WSI=0 ;;
	esac
	log "exec: $GAMESCOPE_BIN $_EMBED_UNDER_X $FULLSCREEN $_GAMESCOPE_WH $_GAMESCOPE_GAME_WH $_GAMESCOPE_REFRESH $_GAMESCOPE_HIDE_CURSOR $_xwayland ${GAMEBIAN_GAMESCOPE_EXTRA_ARGS:-} -- $STEAM_BIN ${_steam_extras} $_steam_args"
	# shellcheck disable=SC2086
	"$GAMESCOPE_BIN" $_EMBED_UNDER_X $FULLSCREEN $_GAMESCOPE_WH $_GAMESCOPE_GAME_WH $_GAMESCOPE_REFRESH $_GAMESCOPE_HIDE_CURSOR $_xwayland ${GAMEBIAN_GAMESCOPE_EXTRA_ARGS:-} -- "$STEAM_BIN" ${_steam_extras} $_steam_args "$@" &
	_gs_pid=$!
	_rc=0
	_handoff="${GAMEBIAN_SWITCH_OPENBOX:-${HOME}/.config/gamebian/switch-to-openbox}"
	while kill -0 "$_gs_pid" 2>/dev/null; do
		if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ] && [ -f "${_handoff}" ]; then
			log "Switch to Desktop: stopping gamescope kiosk (pid ${_gs_pid})"
			gamebian_stop_gamescope_pid "$_gs_pid"
			if command -v gamebian_kill_steam_kiosk_tree >/dev/null 2>&1; then
				gamebian_kill_steam_kiosk_tree
			fi
			return 0
		fi
		sleep 0.25
	done
	wait "$_gs_pid" 2>/dev/null || _rc=$?
	# gamescope can exit 0 immediately when a second instance races the first.
	if [ "${_rc}" -eq 0 ] && [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ]; then
		sleep 1
		if ! pgrep -u "$(id -un)" -x gamescope >/dev/null 2>&1 \
			&& ! pgrep -u "$(id -un)" -f 'gamescopereaper' >/dev/null 2>&1; then
			log "gamescope exited 0 but no compositor left — treating as failure"
			return 1
		fi
	fi
	return $_rc
}

_steam_direct() {
	_steam_args="$1"
	log "exec: $STEAM_BIN ${_steam_extras} $_steam_args (no gamescope — VM/llvmpipe or GAMEBIAN_SKIP_GAMESCOPE)"
	# shellcheck disable=SC2086
	exec "$STEAM_BIN" ${_steam_extras} $_steam_args "$@"
}

_launch() {
	_rc=1
	_gamescope_tried=0
	if [ "$_use_gamescope" -eq 1 ]; then
		_gamescope_tried=1
		if _run_gamescope "$_steam_mode"; then
			return 0
		fi
		log "gamescope exited $? (mode=${_steam_mode}; common on VirtualBox/llvmpipe: no VK_EXT_physical_device_drm)"
		if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ]; then
			mkdir -p "${HOME}/.config/gamebian" 2>/dev/null || true
			: >"${HOME}/.config/gamebian/steam-without-gamescope" 2>/dev/null || true
		fi
		if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ] \
			&& [ -f "${GAMEBIAN_SWITCH_OPENBOX:-${HOME}/.config/gamebian/switch-to-openbox}" ]; then
			return 0
		fi
		if [ "${_gamescope_tried}" -eq 1 ] && [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ]; then
			log "kiosk: gamescope unavailable — starting Steam on X once (no relaunch loop; GAMEBIAN_SKIP_GAMESCOPE=1 in steam-gamescope.env to skip gamescope)"
			_use_gamescope=0
		fi
	fi
	if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ]; then
		if [ "${_use_gamescope}" -eq 0 ]; then
			log "kiosk: Steam on X (gamescope skipped)"
			_steam_direct "$_steam_mode"
		elif [ "${_gamescope_tried}" -eq 1 ] && [ "${_use_gamescope}" -eq 0 ]; then
			log "kiosk: gamescope unavailable — Steam on X (runtime fallback)"
			_steam_direct "$_steam_mode"
		elif gamebian_use_steam_without_gamescope 2>/dev/null \
			|| [ -f "${HOME}/.config/gamebian/steam-without-gamescope" ]; then
			log "kiosk: gamescope unavailable — Steam on X (steam-without-gamescope)"
			_steam_direct "$_steam_mode"
		else
			log "kiosk: gamescope failed — not starting desktop Steam (would look like Openbox Steam)"
		fi
		return 1
	fi
	log "starting Steam without gamescope"
	_steam_direct "$_steam_mode"
	return 1
}

# LightDM kiosk: after Steam/gamescope quits, hand off to Openbox if user chose Switch to Desktop.
if [ -n "${GAMEBIAN_GAMESCOPE_SESSION:-}" ]; then
	_launch "$@"
	_handoff="${GAMEBIAN_SWITCH_OPENBOX:-${HOME}/.config/gamebian/switch-to-openbox}"
	if [ -f "${_handoff}" ] || pgrep -u "$(id -un)" -x openbox >/dev/null 2>&1; then
		if pgrep -u "$(id -un)" -x openbox >/dev/null 2>&1; then
			log "Switch to Desktop: openbox already running — refresh desktop notices"
			rm -f "${_handoff}" 2>/dev/null || true
			gamebian_kiosk_openbox_handoff_set 2>/dev/null || true
			gamebian_kiosk_marker_clear 2>/dev/null || true
			gamebian_controller_menu_resume 2>/dev/null || true
			if [ -x /usr/share/gamebian/gamebian-openbox-notify.sh ]; then
				/usr/share/gamebian/gamebian-openbox-notify.sh --no-wait --desktop-session &
			fi
			exit 0
		fi
		log "Switch to Desktop: handoff to openbox-session"
		gamebian_handoff_to_openbox_desktop
		# Return to gamescope-session supervisor (same LightDM login).
		exit 0
	fi
	exit $?
fi

# Openbox / menu: try gamescope, fall back to plain Steam on failure.
_launch "$@"
exit $?
