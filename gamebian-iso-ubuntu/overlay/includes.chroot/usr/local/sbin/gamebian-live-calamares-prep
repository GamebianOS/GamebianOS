#!/bin/sh
# Live ISO: DNS, welcome checks, SSH, and install-disk prep before Calamares starts.
set -e

if ! grep -qw boot=live /proc/cmdline 2>/dev/null; then
	exit 0
fi

# DNS — empty /etc/resolv.conf breaks Calamares internet check.
if [ -x /usr/local/sbin/gamebian-live-dns-fix ]; then
	/usr/local/sbin/gamebian-live-dns-fix
fi

# Welcome: no storage check on live (requiredStorage measures overlay, not /dev/sda).
_welcome=/etc/calamares/modules/welcome.conf
if [ -f "$_welcome" ]; then
	sed -i '/^[[:space:]]*- storage[[:space:]]*$/d' "$_welcome"
	sed -i '/^[[:space:]]*requiredStorage:/d' "$_welcome"
fi

# SSH for remote debugging (host keys + socket).
if [ -x /usr/local/sbin/gamebian-sshd-live-prep ]; then
	/usr/local/sbin/gamebian-sshd-live-prep 2>/dev/null || true
fi
if command -v systemctl >/dev/null 2>&1; then
	systemctl start ssh.socket 2>/dev/null || true
fi

# Unmount target disk if something left it mounted (blocks Erase in Calamares).
if [ -b /dev/sda1 ]; then
	_mount="$(findmnt -n -o TARGET /dev/sda1 2>/dev/null || true)"
	if [ -n "${_mount:-}" ]; then
		umount /dev/sda1 2>/dev/null || umount "$_mount" 2>/dev/null || true
	fi
fi

# Wired network on VirtualBox etc.
if [ -f /usr/lib/NetworkManager/conf.d/10-globally-managed-devices.conf ]; then
	rm -f /usr/lib/NetworkManager/conf.d/10-globally-managed-devices.conf
	systemctl reload NetworkManager 2>/dev/null || true
fi

exit 0
