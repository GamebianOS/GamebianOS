#!/bin/sh
# Install Mupen64Plus-Next for RetroArch (not in Debian trixie apt).
# ISO hook 997, Calamares gamebian-web-install, or: sudo /usr/local/sbin/gamebian-install-libretro-mupen64plus-next
set +e

export DEBIAN_FRONTEND=noninteractive
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

INSTALL_DIR="${INSTALL_DIR:-/usr/lib/x86_64-linux-gnu/libretro}"
BUILD_DIR="${BUILD_DIR:-/var/tmp/gamebian-mupen64plus-next-build}"
REF="${GAMEBIAN_MUPEN64_GIT_REF:-develop}"
REPO="${GAMEBIAN_MUPEN64_REPO:-https://github.com/libretro/mupen64plus-libretro-nx.git}"
SO_NAME="mupen64plus_next_libretro.so"
ZIP_URL="${GAMEBIAN_MUPEN64_ZIP_URL:-https://buildbot.libretro.com/nightly/linux/x86_64/latest/${SO_NAME}.zip}"

log() { printf '[install-mupen64] %s\n' "$*"; }

if [ "$(id -u)" -ne 0 ]; then
	exec sudo "$0" "$@"
fi

if [ -f "${INSTALL_DIR}/${SO_NAME}" ]; then
	log "already installed: ${INSTALL_DIR}/${SO_NAME}"
	exit 0
fi

if ! command -v retroarch >/dev/null 2>&1; then
	log "warning: retroarch not installed — install ubuntu-retroarch.list packages first" >&2
	exit 1
fi

retroarch_version() {
	retroarch --version 2>/dev/null | sed -n 's/.*Version: \([0-9.]*\).*/\1/p' | head -1
}

needs_source_build() {
	case "${GAMEBIAN_MUPEN64_BUILD:-}" in
		1) return 0 ;;
		0) return 1 ;;
	esac
	case "${GAMEBIAN_MUPEN64_DOWNLOAD:-}" in
		1) return 1 ;;
	esac
	_ver="$(retroarch_version)"
	[ -n "$_ver" ] || return 0
	_major="${_ver%%.*}"
	_minor="${_ver#*.}"
	_minor="${_minor%%.*}"
	[ "${_major:-0}" -lt 1 ] && return 0
	[ "${_major}" -eq 1 ] && [ "${_minor:-0}" -le 20 ] && return 0
	return 1
}

install_so() {
	_src="$1"
	mkdir -p "${INSTALL_DIR}" || return 1
	install -m 0644 "${_src}" "${INSTALL_DIR}/${SO_NAME}" || return 1
	log "installed ${INSTALL_DIR}/${SO_NAME}"
	return 0
}

verify_core() {
	_so="${INSTALL_DIR}/${SO_NAME}"
	if [ ! -f "$_so" ]; then
		log "verify: missing $_so" >&2
		return 1
	fi
	_size="$(wc -c <"$_so" 2>/dev/null | tr -d ' ')"
	if [ "${_size:-0}" -lt 500000 ]; then
		log "verify: $_so too small (${_size} bytes)" >&2
		return 1
	fi
	if command -v ldd >/dev/null 2>&1; then
		_missing="$(ldd "$_so" 2>&1 | grep 'not found' || true)"
		if [ -n "$_missing" ]; then
			log "verify: unresolved libraries:" >&2
			printf '%s\n' "$_missing" >&2
			return 1
		fi
	fi
	log "verify OK ($(wc -c <"$_so" | tr -d ' ') bytes)"
	return 0
}

download_core() {
	_tmp="$(mktemp -d)" || return 1
	_zip="${_tmp}/${SO_NAME}.zip"
	log "downloading ${ZIP_URL}"
	apt-get install -y --no-install-recommends curl ca-certificates unzip >/dev/null 2>&1 \
		|| apt-get install -y --no-install-recommends curl ca-certificates unzip
	curl -fsSL -o "${_zip}" "${ZIP_URL}" || {
		rm -rf "${_tmp}"
		return 1
	}
	unzip -q -o "${_zip}" -d "${_tmp}" || {
		rm -rf "${_tmp}"
		return 1
	}
	if [ ! -f "${_tmp}/${SO_NAME}" ]; then
		rm -rf "${_tmp}"
		return 1
	fi
	install_so "${_tmp}/${SO_NAME}"
	_rc=$?
	rm -rf "${_tmp}"
	return $_rc
}

build_core() {
	log "installing build dependencies"
	apt-get update -qq 2>/dev/null || apt-get update
	apt-get install -y --no-install-recommends \
		build-essential git pkg-config nasm \
		zlib1g-dev libminizip-dev libpng-dev \
		libsdl2-dev libglu1-mesa-dev libglew-dev \
		libgl1-mesa-dev || return 1

	mkdir -p "${BUILD_DIR}" || return 1
	if [ ! -d "${BUILD_DIR}/.git" ]; then
		log "cloning ${REPO} (${REF})"
		git clone --depth 1 --branch "${REF}" "${REPO}" "${BUILD_DIR}" || return 1
	else
		log "updating existing clone"
		git -C "${BUILD_DIR}" fetch --depth 1 origin "${REF}" 2>/dev/null || true
		git -C "${BUILD_DIR}" checkout -f "${REF}" 2>/dev/null || true
		git -C "${BUILD_DIR}" pull --ff-only 2>/dev/null || true
	fi

	log "building (several minutes)"
	make -C "${BUILD_DIR}" -j"$(nproc)" clean 2>/dev/null || true
	make -C "${BUILD_DIR}" -j"$(nproc)" || return 1
	[ -f "${BUILD_DIR}/${SO_NAME}" ] || return 1
	install_so "${BUILD_DIR}/${SO_NAME}"
}

if needs_source_build; then
	log "RetroArch $(retroarch_version || echo unknown) — compiling for distro libretro ABI"
	build_core
elif ! download_core; then
	log "download failed; falling back to source build"
	build_core
else
	log "downloaded core (use GAMEBIAN_MUPEN64_BUILD=1 if RetroArch crashes)"
fi

if verify_core; then
	exit 0
fi

rm -f "${INSTALL_DIR}/${SO_NAME}" 2>/dev/null || true
log "failed to install ${SO_NAME}" >&2
exit 1
