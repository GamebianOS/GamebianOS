#!/bin/sh
# Live installer window only. The installed system removes Openbox.

if [ -r /usr/share/gamebian/gamebian-display-resolution.sh ]; then
	# shellcheck source=/usr/share/gamebian/gamebian-display-resolution.sh
	. /usr/share/gamebian/gamebian-display-resolution.sh
	gamebian_ensure_native_resolution 2>/dev/null || true
fi

if [ -r /usr/share/gamebian/gamebian-session-log.sh ]; then
	# shellcheck source=/usr/share/gamebian/gamebian-session-log.sh
	. /usr/share/gamebian/gamebian-session-log.sh
	gamebian_session_log "live-installer" ""
fi

# PolicyKit UI so Calamares can talk to UDisks2.
POLKIT_AGENT=""
for _p in /usr/libexec/polkit-gnome-authentication-agent-1 \
	/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
	/usr/libexec/polkit-mate-authentication-agent-1 \
	/usr/bin/lxpolkit; do
	if [ -x "${_p}" ]; then
		POLKIT_AGENT="${_p}"
		break
	fi
done
if [ -n "${POLKIT_AGENT}" ]; then
	"${POLKIT_AGENT}" >/dev/null 2>&1 &
fi

if ! grep -qw boot=live /proc/cmdline 2>/dev/null; then
	exit 0
fi

# Wi-Fi dialog when the live session has no network yet (Calamares requires internet).
if command -v nm-online >/dev/null 2>&1 && ! nm-online -q -t 3 2>/dev/null; then
	if command -v nm-connection-editor >/dev/null 2>&1; then
		nm-connection-editor >/dev/null 2>&1 &
	fi
fi

# Calamares only on the live session (wait for polkit, disk probe, DNS, network).
(
	if pgrep -x calamares >/dev/null 2>&1; then
		exit 0
	fi
	sleep 5
	for _ in $(seq 1 30); do
		pgrep -f 'authentication-agent' >/dev/null 2>&1 && break
		sleep 0.5
	done
	for _ in $(seq 1 60); do
		_size="$(lsblk -bdno SIZE /dev/sda 2>/dev/null || echo 0)"
		[ "${_size:-0}" -gt 1000000000 ] 2>/dev/null && break
		sleep 1
	done
	if [ -x /usr/local/sbin/gamebian-live-calamares-prep ]; then
		sudo /usr/local/sbin/gamebian-live-calamares-prep 2>/dev/null || true
	elif [ -x /usr/local/sbin/gamebian-live-dns-fix ]; then
		sudo /usr/local/sbin/gamebian-live-dns-fix 2>/dev/null || true
	fi
	if command -v nm-online >/dev/null 2>&1; then
		nm-online -q -t 45 2>/dev/null || true
	fi
	for _ in $(seq 1 30); do
		curl -fsSI --connect-timeout 2 --max-time 4 https://networkcheck.kde.org/ >/dev/null 2>&1 && break
		sleep 1
	done
	if pgrep -x calamares >/dev/null 2>&1; then
		exit 0
	fi
	if [ -x /usr/bin/calamares-install-gamebian ]; then
		/usr/bin/calamares-install-gamebian
	elif command -v pkexec >/dev/null 2>&1; then
		pkexec calamares
	else
		sudo -E calamares
	fi
) &
