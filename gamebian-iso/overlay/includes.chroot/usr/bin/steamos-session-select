#!/bin/sh
# SteamOS session-select shim. Gamebian has no desktop session.
# "desktop" is a no-op so Steam's Switch to Desktop does not leave gamescope.
# "gamescope" keeps the gaming session (already the only installed session).

PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games${PATH:+:$PATH}"
export PATH

_mode="${1:-desktop}"
_log="${XDG_CACHE_HOME:-${HOME}/.cache}/gamebian/session-select.log"
mkdir -p "$(dirname "$_log")" 2>/dev/null || true
_ts="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date)"

case "${_mode}" in
	desktop|openbox|plasma|gnome|xfce)
		printf '%s steamos-session-select: no desktop session (%s)\n' "$_ts" "${_mode}" >>"$_log" 2>/dev/null || true
		echo "Gamebian has no desktop session." >&2
		exit 0
		;;
	gamescope|steam|gaming|gamebian-steam-gamescope)
		rm -f "${HOME}/.config/gamebian/switch-to-openbox" \
			"${HOME}/.config/gamebian/prefer-openbox-desktop" 2>/dev/null || true
		if command -v sudo >/dev/null 2>&1; then
			sudo -n /usr/sbin/gamebian-enable-steam-lightdm-session 2>/dev/null || true
		fi
		printf '%s steamos-session-select: stay on gamescope\n' "$_ts" >>"$_log" 2>/dev/null || true
		exit 0
		;;
	*)
		printf '%s steamos-session-select: no desktop session (%s)\n' "$_ts" "${_mode}" >>"$_log" 2>/dev/null || true
		echo "Gamebian has no desktop session." >&2
		exit 0
		;;
esac
