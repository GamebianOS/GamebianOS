#!/bin/sh
# Steam "Switch to Desktop" entry point. Gamebian has no desktop session.
# Exit immediately so Steam does not block, and do not stop gamescope.

PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games${PATH:+:$PATH}"
export PATH

LOG="${XDG_CACHE_HOME:-${HOME}/.cache}/gamebian/switch-to-desktop.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
_ts="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date)"
printf '%s switch-to-desktop: ignored (no desktop session)\n' "$_ts" >>"$LOG" 2>/dev/null || true
echo "Gamebian has no desktop session." >&2
exit 0
