#!/bin/sh
set -e
for _theme in Papirus Papirus-Dark; do
	_dir="/usr/share/icons/${_theme}"
	if [ -d "${_dir}" ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
		gtk-update-icon-cache -f "${_dir}" 2>/dev/null || true
	fi
done

# Dropbox often stores overlay scripts as 0744. live-build copies them as root, so
# without a world/group +x the live user gets "Permission denied" on menu actions.
chmod 0755 /usr/local/bin/gamebian-* 2>/dev/null || true
chmod 0755 /usr/local/sbin/gamebian-* 2>/dev/null || true
chmod 0755 /usr/sbin/gamebian-* 2>/dev/null || true
chmod 0755 /usr/bin/steamos-session-select 2>/dev/null || true
chmod 0755 /usr/share/gamebian/gamebian-nm-status-icon.py 2>/dev/null || true
chmod 0755 /usr/share/gamebian/gamebian-openbox-notify.sh 2>/dev/null || true
chmod 0755 /usr/share/gamebian/gamebian-lxpanel-tray.sh 2>/dev/null || true
chmod 0755 /usr/share/gamebian/gamebian-lxpanel-apply-panel.sh 2>/dev/null || true
chmod 0755 /usr/share/gamebian/gamebian-steam-reboot-notify-watcher.sh 2>/dev/null || true
chmod 0755 /usr/share/gamebian/steam-firstboot-terminal.sh 2>/dev/null || true

# Sourced helpers / session .desktop files stay non-executable.
chmod 0644 /usr/share/gamebian/gamebian-openbox-session-env.sh 2>/dev/null || true
chmod 0644 /usr/share/gamebian/gamebian-steam-gamescope-env.sh 2>/dev/null || true
chmod 0644 /usr/share/gamebian/gamebian-session-log.sh 2>/dev/null || true
chmod 0644 /usr/share/gamebian/gamebian-steam-ready.sh 2>/dev/null || true
chmod 0644 /usr/share/gamebian/xsessions/*.desktop 2>/dev/null || true
chmod 0440 /etc/sudoers.d/gamebian-enable-steam-session 2>/dev/null || true

/usr/local/sbin/gamebian-install-tray-icons 2>/dev/null || true

exit 0
